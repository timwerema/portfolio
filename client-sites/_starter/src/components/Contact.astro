---
import { DEMO, href } from '../lib/theme';
import { site } from '../site';
const b = site.business;
const live = !DEMO && site.form.action !== '';
const field = 'border-line bg-paper text-ink min-h-12 w-full rounded-[var(--radius)] border-2 px-4 text-base';
---

<section id="contact" class="bg-surface scroll-mt-20">
    <div class="mx-auto flex max-w-6xl flex-col gap-10 px-5 py-16 md:flex-row">
        <div class="md:w-2/5">
            <h2 class="text-3xl font-semibold sm:text-4xl">{site.contact.title}</h2>
            <p class="text-muted mt-4 text-lg">{site.contact.text}</p>
            <dl class="mt-6 space-y-3">
                <div>
                    <dt class="text-muted text-sm">Phone</dt>
                    <dd><a href={href('tel')} class="text-brand text-xl font-bold">{b.phone}</a></dd>
                </div>
                {
                    b.email && (
                        <div>
                            <dt class="text-muted text-sm">Email</dt>
                            <dd>
                                <a href={`mailto:${b.email}`} class="font-semibold">
                                    {b.email}
                                </a>
                            </dd>
                        </div>
                    )
                }
                <div>
                    <dt class="text-muted text-sm">Service area</dt>
                    <dd class="font-semibold">{b.serviceArea.join(', ')}</dd>
                </div>
            </dl>
        </div>
        <form
            class="bg-paper border-line flex-1 space-y-4 rounded-[var(--radius)] border p-6 sm:p-8"
            method="POST"
            action={live ? site.form.action : undefined}
            data-live={live ? '1' : '0'}
            id="contact-form"
        >
            <label class="block">
                <span class="font-semibold">Name</span>
                <input name="name" required autocomplete="name" class={field} />
            </label>
            <div class="grid gap-4 sm:grid-cols-2">
                <label class="block">
                    <span class="font-semibold">Phone</span>
                    <input name="phone" type="tel" autocomplete="tel" class={field} />
                </label>
                <label class="block">
                    <span class="font-semibold">Email</span>
                    <input name="email" type="email" required autocomplete="email" class={field} />
                </label>
            </div>
            <label class="block">
                <span class="font-semibold">How can we help?</span>
                <textarea name="message" rows="4" required class={`${field} py-3`}></textarea>
            </label>
            <!-- spam trap: real people never fill this in -->
            <input name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
            <button type="submit" class="btn btn-primary w-full sm:w-auto">Send</button>
            <p id="form-status" role="status" class="text-muted text-sm"></p>
        </form>
    </div>
</section>

<script is:inline>
    // Until the form is connected (or on the demo), say so instead of sending anything.
    (function () {
        var f = document.getElementById('contact-form');
        if (!f || f.dataset.live === '1') return;
        f.addEventListener('submit', function (e) {
            e.preventDefault();
            document.getElementById('form-status').textContent =
                'Thanks! This is a preview, so the form is not connected yet. Nothing was sent.';
        });
    })();
</script>
