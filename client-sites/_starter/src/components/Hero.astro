---
import { href, style } from '../lib/theme';
import { site } from '../site';
const h = site.hero;
const link = (to: string) => (to === 'tel' ? href('tel') : href(to));
---

{
    style === 'bold' ? (
        <section class="relative isolate overflow-hidden">
            <img src={h.image} alt={h.imageAlt} class="absolute inset-0 -z-10 size-full object-cover" />
            <div class="absolute inset-0 -z-10 bg-black/60" />
            <div class="mx-auto max-w-6xl px-5 py-24 text-white sm:py-36">
                <p class="text-accent font-bold tracking-wider uppercase">{h.eyebrow}</p>
                <h1 class="mt-3 max-w-4xl text-5xl leading-[0.95] font-black sm:text-7xl">{h.title}</h1>
                <p class="mt-6 max-w-xl text-lg text-white/85">{h.text}</p>
                <div class="mt-8 flex flex-wrap gap-3">
                    <a href={link(h.primary.href)} class="btn btn-primary">{h.primary.label}</a>
                    <a href={link(h.secondary.href)} class="btn btn-outline">{h.secondary.label}</a>
                </div>
            </div>
        </section>
    ) : style === 'minimal' ? (
        <section class="mx-auto max-w-4xl px-5 py-20 text-center sm:py-28">
            <p class="text-brand font-semibold">{h.eyebrow}</p>
            <h1 class="mt-3 text-4xl leading-tight font-bold sm:text-6xl">{h.title}</h1>
            <p class="text-muted mx-auto mt-5 max-w-2xl text-lg">{h.text}</p>
            <div class="mt-8 flex flex-wrap justify-center gap-3">
                <a href={link(h.primary.href)} class="btn btn-primary">{h.primary.label}</a>
                <a href={link(h.secondary.href)} class="btn btn-outline">{h.secondary.label}</a>
            </div>
            <img src={h.image} alt={h.imageAlt} class="mt-14 aspect-[16/8] w-full rounded-[var(--radius)] object-cover" />
        </section>
    ) : (
        <section class="mx-auto flex max-w-6xl flex-col items-center gap-10 px-5 py-16 sm:py-24 md:flex-row">
            <div class="flex-1">
                <p class="text-brand font-semibold">{h.eyebrow}</p>
                <h1 class="mt-3 text-4xl leading-tight font-semibold sm:text-6xl">{h.title}</h1>
                <p class="text-muted mt-5 max-w-xl text-lg">{h.text}</p>
                <div class="mt-8 flex flex-wrap gap-3">
                    <a href={link(h.primary.href)} class="btn btn-primary">{h.primary.label}</a>
                    <a href={link(h.secondary.href)} class="btn btn-outline">{h.secondary.label}</a>
                </div>
            </div>
            <img src={h.image} alt={h.imageAlt} class="aspect-[4/3] w-full flex-1 rounded-[var(--radius)] object-cover md:max-w-[520px]" />
        </section>
    )
}
