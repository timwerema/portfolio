---
import { external, href } from '../lib/theme';
import { site } from '../site';
const b = site.business;
const l = site.location;
const directions = href('directions');
---

<section id="location" class="border-line scroll-mt-20 border-t">
    <div class="mx-auto flex max-w-6xl flex-wrap gap-x-16 gap-y-8 px-5 py-16">
        <div class="min-w-0 flex-[1_1_280px]">
            <h2 data-reveal="mask" class="text-3xl font-semibold sm:text-4xl">{l.title}</h2>
            <p class="mt-4 text-lg">
                {b.address.street && <>{b.address.street}<br /></>}
                {b.address.city}, {b.address.region} {b.address.postal}
            </p>
            {l.note && <p class="text-muted mt-2">{l.note}</p>}
            <div class="mt-6 flex flex-wrap gap-3">
                <a href={directions} {...external(directions)} class="btn btn-primary">Get directions</a>
                <a href={href('tel')} class="btn btn-outline">Call {b.phone}</a>
            </div>
        </div>
        <div class="min-w-0 flex-[1_1_280px]">
            <h3 class="text-xl font-semibold">Hours</h3>
            <table data-reveal class="mt-3 w-full max-w-sm">
                <tbody>
                    {
                        b.hours.map((h) => (
                            <tr class="border-line border-b">
                                <th scope="row" class="py-2 text-left font-medium">
                                    {h.days}
                                </th>
                                <td class="text-muted py-2 text-right">
                                    {h.open} - {h.close}
                                </td>
                            </tr>
                        ))
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
