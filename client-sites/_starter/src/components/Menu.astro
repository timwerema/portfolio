---
import { site } from '../site';
const m = site.menu;
const TAGS: Record<string, string> = { V: 'Vegetarian', VG: 'Vegan', GF: 'Gluten-free', S: 'Spicy' };
const slug = (s: string) => 'menu-' + s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const used = [...new Set(m.sections.flatMap((s) => s.items.flatMap((i) => i.tags)))];
---

<section id="menu" class="scroll-mt-20">
    <div class="mx-auto max-w-4xl px-5 py-16">
        <h2 data-reveal="mask" class="text-3xl font-semibold sm:text-4xl">{m.title}</h2>
        {
            m.sections.length > 1 && (
                <nav aria-label="Menu sections" class="mt-6 flex flex-wrap gap-2">
                    {m.sections.map((s) => (
                        <a href={`#${slug(s.name)}`} class="border-line rounded-full border px-4 py-2 text-sm font-semibold">
                            {s.name}
                        </a>
                    ))}
                </nav>
            )
        }
        {
            m.sections.map((s) => (
                <div id={slug(s.name)} class="mt-10 scroll-mt-24">
                    <h3 class="text-brand text-sm font-bold tracking-widest uppercase">{s.name}</h3>
                    <ul class="mt-3">
                        {s.items.map((i) => (
                            <li data-reveal class="border-line border-b py-4">
                                <p class="flex items-baseline gap-3">
                                    <span class="text-lg font-semibold">{i.name}</span>
                                    {i.tags.map((t) => (
                                        <abbr title={TAGS[t] ?? t} class="text-muted border-line rounded border px-1.5 text-xs font-bold no-underline">
                                            {t}
                                        </abbr>
                                    ))}
                                    <span class="border-line flex-1 translate-y-[-4px] border-b border-dotted" aria-hidden="true" />
                                    <span class="font-bold">{i.price}</span>
                                </p>
                                {i.text && <p class="text-muted mt-1">{i.text}</p>}
                            </li>
                        ))}
                    </ul>
                </div>
            ))
        }
        <p class="text-muted mt-6 text-sm">
            {used.map((t) => `${t} = ${TAGS[t] ?? t}`).join(' · ')}
            {m.note && <><br />{m.note}</>}
        </p>
    </div>
</section>
