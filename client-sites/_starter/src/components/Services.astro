---
import { href } from '../lib/theme';
import { site } from '../site';
interface Props {
    heading?: string;
}
const { heading = 'What we do' } = Astro.props;
---

<section id="services" class="border-line scroll-mt-20 border-t">
    <div class="mx-auto max-w-6xl px-5 py-16">
        <h2 data-reveal="mask" class="text-3xl font-semibold sm:text-4xl">{heading}</h2>
        <ul class="border-line mt-8 border-t">
            {
                site.services.map((s) => (
                    <li data-reveal class="border-line flex flex-wrap items-baseline gap-x-8 gap-y-1 border-b py-6">
                        <h3 class="min-w-[200px] flex-1 text-xl font-semibold">{s.name}</h3>
                        <p class="text-muted flex-[2_1_320px]">{s.text}</p>
                        <p class="text-brand font-bold whitespace-nowrap">{s.price}</p>
                    </li>
                ))
            }
        </ul>
        <a href={href('contact')} class="btn btn-primary mt-8">Get a free quote</a>
    </div>
</section>
