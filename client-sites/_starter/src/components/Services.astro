---
import { href } from '../lib/theme';
import { site } from '../site';
interface Props {
    heading?: string;
}
const { heading = 'What we do' } = Astro.props;
---

<section id="services" class="border-line scroll-mt-20 border-t">
    <div class="mx-auto max-w-6xl px-5 section-y">
        <h2 data-reveal="mask" class="h-section rule">{heading}</h2>
        <ul class="border-line mt-8 border-t">
            {
                site.services.map((s) => (
                    <li data-reveal class="border-line border-b py-6">
                        <div class="flex items-baseline gap-3">
                            <h3 class="text-xl font-semibold sm:text-2xl">{s.name}</h3>
                            <span class="leader" aria-hidden="true" />
                            {s.price && <p class="text-brand text-lg font-bold whitespace-nowrap">{s.price}</p>}
                        </div>
                        <p class="text-muted mt-1 max-w-2xl">{s.text}</p>
                    </li>
                ))
            }
        </ul>
        <a href={href('contact')} class="btn btn-primary mt-8">Get a free quote</a>
    </div>
</section>
