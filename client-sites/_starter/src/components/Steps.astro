---
import { site } from '../site';
---

<section class="bg-surface">
    <div class="mx-auto max-w-6xl px-5 py-16">
        <h2 class="text-3xl font-semibold sm:text-4xl">How it works</h2>
        <ol class="mt-8 grid gap-8 md:grid-cols-3">
            {
                site.steps.map((s, i) => (
                    <li class="border-brand border-t-4 pt-4">
                        <p class="text-brand font-display text-3xl font-bold">{String(i + 1).padStart(2, '0')}</p>
                        <h3 class="mt-2 text-xl font-semibold">{s.title}</h3>
                        <p class="text-muted mt-1">{s.text}</p>
                    </li>
                ))
            }
        </ol>
    </div>
</section>
