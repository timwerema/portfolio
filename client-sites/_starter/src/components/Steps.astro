---
import { site } from '../site';
---

<section class="bg-surface">
    <div class="mx-auto max-w-6xl px-5 section-y">
        <h2 data-reveal="mask" class="h-section rule">How it works</h2>
        <ol class="mt-8 grid gap-8 md:grid-cols-3">
            {
                site.steps.map((s, i) => (
                    <li data-reveal class="border-ink border-t-2 pt-5">
                        <p class="text-brand font-display text-6xl leading-none font-black" aria-hidden="true">{i + 1}</p>
                        <h3 class="mt-2 text-xl font-semibold">{s.title}</h3>
                        <p class="text-muted mt-1">{s.text}</p>
                    </li>
                ))
            }
        </ol>
    </div>
</section>
