---
import { href } from '../lib/theme';
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
    <section class="mx-auto max-w-3xl px-5 py-24 text-center">
        <h1 class="text-4xl font-semibold">Page not found</h1>
        <p class="text-muted mt-3">That page moved or never existed.</p>
        <a href={href('home')} class="btn btn-primary mt-8">Back to the homepage</a>
    </section>
</Base>
